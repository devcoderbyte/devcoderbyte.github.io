---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
{%- if p.layout == 'redirect' or p.sitemap == false or p.layout == null or p.url contains 'google' or p.url contains '.xml' or p.url contains '.txt' -%}{%- continue -%}{%- endif %}
  <url><loc>{{ site.url }}{{ p.url | replace: 'index.html', '' }}</loc><changefreq>monthly</changefreq></url>
{%- endfor %}
</urlset>
